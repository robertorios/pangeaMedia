# Copy to .env:  cp .env.example .env
# Use the same DB_USER / DB_PASS as pangeaUsers (one MySQL account for all apps in dev).
# Create the user with pangeaUsers/config/mysql_development_user.sql

DB_USER=pangea_dev
DB_PASS=change_me_local_only

# JWT signing/verification secret. MUST be the SAME value in all three
# services (pangeaUsers, pangeaMedia, pangeaConversations) — a token minted
# by pangeaUsers is verified here. Generate one with:
#   ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
JWT_SECRET_KEY=

# Comma-separated SPA Origins for CORS (credentials). Exact URLs only — no "*".
# Development includes localhost defaults; production REQUIRES this list.
# CORS_ALLOWED_ORIGINS=https://your-spa.example

# S3 presigned uploads (UploadsController#presign). Required on your machine — not optional:
# Without these, the AWS SDK tries EC2 instance metadata (169.254.169.254) and fails locally.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
